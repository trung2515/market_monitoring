{
  "name": "market-monitoring",
  "version": "0.1.0",
  "private": true,
  "description": "Theo dõi giá & sản phẩm đối thủ trên Điện Máy Xanh, xuất báo cáo Excel theo tuần/tháng",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "crawl": "tsx src/cli/crawl.ts",
    "export": "tsx src/cli/export.ts",
    "crawl:prod": "node dist/cli/crawl.js",
    "export:prod": "node dist/cli/export.js",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"tests/**/*.test.ts\""
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "node-cron": "^4.2.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^22.15.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
