{
  "name": "market-monitoring",
  "version": "0.1.0",
  "private": true,
  "description": "Theo dõi giá & sản phẩm đối thủ trên Điện Máy Xanh, xuất báo cáo Excel theo tuần/tháng",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "npm run build:client && tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json && npm run build:client",
    "start": "node dist/index.js",
    "crawl": "tsx src/cli/crawl.ts",
    "export": "tsx src/cli/export.ts",
    "crawl:prod": "node dist/cli/crawl.js",
    "export:prod": "node dist/cli/export.js",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"tests/**/*.test.ts\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build:client": "esbuild src/client/report.ts --bundle --minify --format=iife --platform=browser --target=es2022 --outfile=public/report.bundle.js",
    "cf:dev": "npm run build:client && wrangler dev",
    "cf:deploy": "npm run build:client && wrangler deploy",
    "cf:migrations": "tsx scripts/gen-d1-migrations.ts",
    "cf:migrate": "wrangler d1 migrations apply elmich-monitor --remote",
    "cf:export-data": "tsx scripts/export-d1-data.ts",
    "cf:import-data": "wrangler d1 execute elmich-monitor --remote --file=data/d1-import.sql",
    "cf:pull-data": "tsx scripts/pull-d1-data.ts"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "node-cron": "^4.2.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^22.15.0",
    "esbuild": "^0.25.0",
    "prettier": "^3.8.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "wrangler": "^4.50.0"
  }
}
