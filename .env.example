# ---- Web ----
PORT=3000
# Bật đăng nhập (Basic Auth) cho giao diện web. Để trống = không yêu cầu đăng nhập.
AUTH_USER=admin
AUTH_PASSWORD=doi-mat-khau-nay

# ---- Lưu trữ ----
DB_PATH=data/market.db
TRACKING_CONFIG=config/tracking.json
TIMEZONE=Asia/Ho_Chi_Minh

# ---- Crawler Điện Máy Xanh ----
# Khu vực giá. 1027 là khu vực mặc định của web khi chưa chọn tỉnh.
# Giữ cố định giá trị này để số liệu giữa các kỳ so sánh được với nhau.
DMX_PROVINCE_ID=1027
DMX_PAGE_SIZE=50
# Nghỉ giữa 2 request (ms) – đừng để quá thấp để tránh làm phiền hệ thống của ĐMX / bị chặn IP
DMX_REQUEST_DELAY_MS=2000
DMX_REQUEST_TIMEOUT_MS=20000
DMX_MAX_RETRIES=3

# ---- Lịch cào tự động (cron, theo TIMEZONE) ----
# Mặc định 8:17 sáng và 22:17 tối mỗi ngày
CRAWL_CRON=17 8,22 * * *
CRAWL_ON_SCHEDULE=true

# debug | info | warn | error
LOG_LEVEL=info
