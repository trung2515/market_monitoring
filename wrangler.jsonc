// Cấu hình Cloudflare Workers – xem hướng dẫn deploy trong README (mục "Chạy miễn phí trên Cloudflare").
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "elmich-monitor",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-11-01",

  // Web tĩnh trong public/. run_worker_first: mọi request đi qua Worker trước để kiểm tra đăng nhập.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },

  // Database D1. Tạo bằng `npx wrangler d1 create elmich-monitor`.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "elmich-monitor",
      "database_id": "5e83d2a6-9655-4f82-a6c7-b2cc6d6b6d02",
      "migrations_dir": "cloudflare/migrations"
    }
  ],

  // Giờ UTC (= giờ VN − 7). Mỗi ngày tự lấy dữ liệu 1 lần, mỗi phút xử lý 1 trang:
  //   "25-59 0 * * *" = 7:25–7:59 sáng giờ VN: bắt đầu lượt cào (phải giống START_CRONS trong src/worker/index.ts)
  //   "* 1 * * *"     = 8:00–8:59: làm tiếp nếu chưa xong (18 danh mục ≈ 60–80 trang)
  //   "*/10 2-23 * * *" = 10 phút một lần trong ngày: làm tiếp lượt dang dở (vd bấm "Lấy data hôm nay" rồi đóng trang)
  // Gói free cho tối đa 5 cron mỗi tài khoản.
  "triggers": {
    "crons": ["25-59 0 * * *", "* 1 * * *", "*/10 2-23 * * *"]
  },

  "vars": {
    "TIMEZONE": "Asia/Ho_Chi_Minh",
    "DMX_PROVINCE_ID": "1027",
    "LOG_LEVEL": "info"
  },

  "observability": { "enabled": true }
}
